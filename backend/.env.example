NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://oyewell:oyewell@localhost:5432/oyewell?schema=public
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# Payment providers (optional, mock used when not set)
PAYMENT_PROVIDER=mock
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=

# Map / geocoding (optional, falls back to configured city/area)
MAP_PROVIDER=mapbox
MAPBOX_TOKEN=
GOOGLE_MAPS_API_KEY=

# Admin user seeded on first run
ADMIN_EMAIL=admin@oyewell.com
ADMIN_PASSWORD=change-me
