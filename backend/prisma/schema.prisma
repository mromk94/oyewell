generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  ADMIN
  RIDER
  COOK
}

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  password  String
  firstName String?
  lastName  String?
  phone     String?
  role      UserRole   @default(CUSTOMER)
  roles     String[]   @default([])
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  orders    Order[]
  rider     Rider?
  cookProfile CookProfile?
  addresses UserAddress[]
}

enum OrderingMode {
  PLATE
  PORTION
  PIECE
}

enum FoodStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Food {
  id           String       @id @default(cuid())
  name         String
  slug         String       @unique
  description  String?
  heroImage    String?
  galleryImages String[]
  videos       String[]
  status       FoodStatus   @default(DRAFT)
  isAvailable  Boolean      @default(true)
  featured     Boolean      @default(false)
  displayOrder Int          @default(0)
  orderingMode OrderingMode @default(PLATE)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  options      FoodOption[]
}

model FoodOption {
  id           String  @id @default(cuid())
  food         Food    @relation(fields: [foodId], references: [id], onDelete: Cascade)
  foodId       String
  label        String
  value        String?
  priceKobo    Int
  stock        Int?
  isAvailable  Boolean @default(true)
  displayOrder Int     @default(0)
}

enum DeliveryZoneType {
  CITY
  AREA
  RADIUS
  POLYGON
}

model DeliveryZone {
  id               String                @id @default(cuid())
  name             String
  type             DeliveryZoneType
  boundary         Json
  isActive         Boolean               @default(true)
  feeKobo          Int                   @default(0)
  minOrderKobo     Int?
  estimatedMinutes Int?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  orders           Order[]
  pricingRules     DeliveryPricingRule[]
}

model DeliveryPricingRule {
  id              String        @id @default(cuid())
  zone            DeliveryZone  @relation(fields: [deliveryZoneId], references: [id], onDelete: Cascade)
  deliveryZoneId  String
  deliveryType    DeliveryType
  baseFeeKobo     Int           @default(0)
  perMeterKobo    Int           @default(0)
  minOrderKobo    Int           @default(0)
  estimatedMinutes Int?
  enabled         Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([deliveryZoneId, deliveryType])
}

model Rider {
  id                         String            @id @default(cuid())
  user                       User              @relation(fields: [userId], references: [id])
  userId                     String            @unique
  vehicle                    String?
  bankName                   String?
  bankAccountName            String?
  bankAccountNumber          String?
  isActive                   Boolean           @default(true)
  available                  Boolean           @default(true)
  isApproved                 Boolean           @default(false)
  neighborhoodApproval       PartnerApproval   @default(PENDING)
  professionalApproval       PartnerApproval   @default(NOT_APPLIED)
  professionalUpgradeStatus  String            @default("")
  canAcceptNeighborhood      Boolean           @default(false)
  deliveryMode               DeliveryMode      @default(MOTORCYCLE)
  serviceRadiusMeters        Int               @default(5000)
  operatingArea              String?
  kycStatus                  KycStatus         @default(NOT_STARTED)
  operationalStatus          OperationalStatus @default(OFFLINE)
  location                   RiderLocation?
  inspections                RiderInspection[]
  payoutRequests             RiderPayoutRequest[]
  createdAt                  DateTime          @default(now())
  updatedAt                  DateTime          @updatedAt
  orders                     Order[]
}

enum OrderSource {
  RESTAURANT
  COOK
  OTHER_FUTURE
}

enum DeliveryType {
  NEIGHBORHOOD
  PROFESSIONAL
}

enum DeliveryMode {
  WALK
  BICYCLE
  MOTORCYCLE
  CAR
}

enum PartnerApproval {
  NOT_APPLIED
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum OperationalStatus {
  OFFLINE
  ONLINE
  BUSY
}

enum KycStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  NEEDS_INFORMATION
}

model Order {
  id                       String               @id @default(cuid())
  orderNumber              String               @unique
  customer                 User?                @relation(fields: [customerId], references: [id])
  customerId               String?
  source                   OrderSource          @default(RESTAURANT)
  cook                     CookProfile?         @relation(fields: [cookId], references: [id])
  cookId                   String?
  cookListing              CookListing?         @relation(fields: [cookListingId], references: [id])
  cookListingId            String?
  status                   String               @default("PENDING_PAYMENT")
  paymentStatus            String               @default("PENDING")
  items                    OrderItem[]
  sides                    OrderSide[]
  address                  String
  phone                    String
  deliveryZone             DeliveryZone?        @relation(fields: [deliveryZoneId], references: [id])
  deliveryZoneId           String?
  deliveryType             DeliveryType         @default(NEIGHBORHOOD)
  deliveryFeeKobo          Int
  subtotalKobo             Int
  totalKobo                Int
  currency                 String               @default("NGN")
  payment                  Payment?
  statusHistory            OrderStatusHistory[]
  messages                 Message[]
  review                   Review?
  earning                  CookEarning?
  deliveryCode             String?              @unique
  rider                    Rider?               @relation(fields: [riderId], references: [id])
  riderId                  String?
  riderStatus              String               @default("UNASSIGNED")
  riderFeeKobo             Int                  @default(0)
  riderFeeBasis            DeliveryType?        @default(NEIGHBORHOOD)
  riderPaid                Boolean              @default(false)
  cookAcceptedAt           DateTime?
  cookReadyAt              DateTime?
  deliveredAt              DateTime?
  deliveredCodeVerifiedAt  DateTime?
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt

  @@index([cookId, status])
  @@index([customerId, createdAt])
  @@index([deliveryType, status, riderId])
}

model OrderItem {
  id            String        @id @default(cuid())
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId       String
  cookListing   CookListing?  @relation(fields: [cookListingId], references: [id])
  cookListingId String?
  foodName      String
  optionLabel   String
  optionValue   String?
  unitPriceKobo Int
  quantity      Int
  totalKobo     Int
  orderingMode  String

  @@index([cookListingId])
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  CANCELLED
  EXPIRED
  REFUNDED
}

enum PaymentProvider {
  MOCK
  PAYSTACK
  FLUTTERWAVE
  CRYPTO
  BANK_TRANSFER
}

model Payment {
  id             String           @id @default(cuid())
  order          Order            @relation(fields: [orderId], references: [id])
  orderId        String           @unique
  amountKobo     Int
  currency       String
  provider       PaymentProvider  @default(MOCK)
  providerRef    String?
  status         PaymentStatus    @default(PENDING)
  idempotencyKey String           @unique
  attempts       PaymentAttempt[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model PaymentAttempt {
  id          String        @id @default(cuid())
  payment     Payment       @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  paymentId   String
  providerRef String?
  status      PaymentStatus
  payload     Json?
  createdAt   DateTime      @default(now())
}

model OrderStatusHistory {
  id        String   @id @default(cuid())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  status    String
  actor     String?
  note      String?
  createdAt DateTime @default(now())
}

model RestaurantSetting {
  id           String   @id @default(cuid())
  name         String   @default("OYE Well")
  currency     String   @default("NGN")
  logoUrl      String?
  contactPhone String?
  contactEmail String?
  latitude     Float?
  longitude    Float?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model PaymentMethodConfig {
  id        String   @id @default(cuid())
  name      String   @unique
  enabled   Boolean  @default(false)
  provider  String
  publicKey String?
  config    Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EmailConfig {
  id       String  @id @default(cuid())
  host     String
  port     Int
  secure   Boolean @default(true)
  user     String
  pass     String
  from     String
  enabled  Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Side {
  id          String    @id @default(cuid())
  name        String
  description String?
  priceKobo   Int
  isAvailable Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  orders      OrderSide[]
}

model OrderSide {
  id          String @id @default(cuid())
  order       Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId     String
  side        Side   @relation(fields: [sideId], references: [id])
  sideId      String
  name        String
  priceKobo   Int
  quantity    Int    @default(1)
  totalKobo   Int
}

enum CookProfileStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SUSPENDED
  BANNED
}

enum CookKitchenStatus {
  OPEN
  CLOSED
  PAUSED
  SUSPENDED
  PENDING_APPROVAL
  ADMIN_DISABLED
}

enum CookListingStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  PAUSED
  SOLD_OUT
  ARCHIVED
}

enum MediaType {
  IMAGE
  VIDEO
}

enum CookEarningStatus {
  PENDING
  SETTLED
  CANCELLED
}

model CookProfile {
  id                   String            @id @default(cuid())
  user                 User              @relation(fields: [userId], references: [id])
  userId               String            @unique
  displayName          String
  profilePhoto         String?
  bio                  String?
  latitude             Float?
  longitude            Float?
  serviceRadiusKm      Float             @default(5)
  cuisineSpecialty     String?
  profileStatus        CookProfileStatus @default(PENDING_APPROVAL)
  kitchenStatus        CookKitchenStatus @default(PENDING_APPROVAL)
  rating               Float             @default(0)
  totalOrders          Int               @default(0)
  isActive             Boolean           @default(true)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  listings             CookListing[]
  orders               Order[]
  earnings             CookEarning[]
  reviews              Review[]
}

model CookListing {
  id                   String            @id @default(cuid())
  cook                 CookProfile       @relation(fields: [cookId], references: [id], onDelete: Cascade)
  cookId               String
  title                String
  description          String?
  priceKobo            Int
  currency             String            @default("NGN")
  portionDescription   String?
  prepTimeMinutesMin   Int?
  prepTimeMinutesMax   Int?
  availability         String?
  quantity             Int               @default(0)
  stock                Int               @default(0)
  ingredients          String?
  allergens            String?
  cuisine              String?
  status               CookListingStatus @default(DRAFT)
  isActive             Boolean           @default(false)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  media                CookListingMedia[]
  orderItems           OrderItem[]
  orders               Order[]
  reviews              Review[]

  @@index([status, isActive, createdAt])
  @@index([cookId, status])
}

model CookListingMedia {
  id          String   @id @default(cuid())
  listing     CookListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId   String
  type        MediaType
  url         String
  thumbnailUrl String?
  ordering    Int      @default(0)
  width       Int?
  height      Int?
  duration    Int?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([listingId, ordering])
}

model UserAddress {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  label     String?
  address   String
  latitude  Float?
  longitude Float?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Message {
  id         String   @id @default(cuid())
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId    String
  senderId   String
  recipientId String
  content    String
  createdAt  DateTime @default(now())

  @@index([orderId, createdAt])
}

model Review {
  id          String      @id @default(cuid())
  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId     String      @unique
  customerId  String
  cookId      String?
  listingId   String?
  riderId     String?
  rating      Int
  comment     String?
  createdAt   DateTime    @default(now())
  cook        CookProfile? @relation(fields: [cookId], references: [id], onDelete: SetNull)
  listing     CookListing? @relation(fields: [listingId], references: [id], onDelete: SetNull)

  @@index([cookId])
  @@index([listingId])
}

model CookEarning {
  id          String            @id @default(cuid())
  cook        CookProfile       @relation(fields: [cookId], references: [id], onDelete: Cascade)
  cookId      String
  order       Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId     String            @unique
  amountKobo  Int
  status      CookEarningStatus @default(PENDING)
  settledAt   DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model RiderInspection {
  id            String   @id @default(cuid())
  rider         Rider    @relation(fields: [riderId], references: [id], onDelete: Cascade)
  riderId       String
  scheduledAt   DateTime?
  inspectedAt   DateTime?
  inspector     String?
  result        String   @default("PENDING")
  notes         String?
  photos        String[]
  nextInspectionAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([riderId])
}

model RiderLocation {
  id        String   @id @default(cuid())
  rider     Rider    @relation(fields: [riderId], references: [id], onDelete: Cascade)
  riderId   String   @unique
  latitude  Float
  longitude Float
  updatedAt DateTime @updatedAt

  @@index([latitude, longitude])
}

model RiderPayoutRequest {
  id          String            @id @default(cuid())
  rider       Rider             @relation(fields: [riderId], references: [id], onDelete: Cascade)
  riderId     String
  amountKobo  Int
  status      PayoutStatus      @default(PENDING)
  requestedAt DateTime          @default(now())
  settledAt   DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([riderId, status])
}

enum PayoutStatus {
  PENDING
  SETTLED
  REJECTED
}
