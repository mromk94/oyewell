generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  ADMIN
  RIDER
  COOK
}

model User {
  id          String     @id @default(cuid())
  email       String     @unique
  password    String
  firstName   String?
  lastName    String?
  phone       String?
  balanceKobo Int        @default(0)
  isActive    Boolean    @default(true)
  banReason   String?
  role        UserRole   @default(CUSTOMER)
  roles       String[]   @default([])
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  orders      Order[]
  rider     Rider?
  cookProfile CookProfile?
  addresses UserAddress[]
  managementEmployee ManagementEmployee?
  cookListingLikes CookListingLike[]
  cookListingViews CookListingView[]
  pushTokens PushToken[]
  approvedCooks CookProfile[] @relation("CookApprovedBy")
  approvedFoods Food[] @relation("FoodApprovedBy")
  approvedListings CookListing[] @relation("ListingApprovedBy")
}

model PushToken {
  id        String   @id @default(cuid())
  token     String   @unique
  platform  String   @default("unknown")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

enum OrderingMode {
  PLATE
  PORTION
  PIECE
}

enum FoodStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  PENDING_REVIEW
  REJECTED
}

model Food {
  id                String       @id @default(cuid())
  name              String
  slug              String       @unique
  description       String?
  heroImage         String?
  galleryImage      String[]
  videos            String[]
  packagingCostKobo Int          @default(0)
  status            FoodStatus   @default(DRAFT)
  isAvailable       Boolean      @default(true)
  featured          Boolean      @default(false)
  displayOrder      Int          @default(0)
  orderingMode      OrderingMode @default(PLATE)
  cookId            String?
  cook              CookProfile? @relation(fields: [cookId], references: [id], onDelete: SetNull)
  approvedById      String?
  approvedAt        DateTime?
  approvedBy        User?        @relation("FoodApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  options           FoodOption[]

  @@index([cookId])
}

model FoodOption {
  id           String  @id @default(cuid())
  food         Food    @relation(fields: [foodId], references: [id], onDelete: Cascade)
  foodId       String
  label        String
  value        String?
  priceKobo    Int
  stock        Int?
  isAvailable  Boolean @default(true)
  displayOrder Int     @default(0)
}

enum DeliveryZoneType {
  CITY
  AREA
  RADIUS
  POLYGON
}

model DeliveryZone {
  id               String                @id @default(cuid())
  name             String
  type             DeliveryZoneType
  boundary         Json
  isActive         Boolean               @default(true)
  feeKobo          Int                   @default(0)
  minOrderKobo     Int?
  estimatedMinutes Int?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  orders           Order[]
  pricingRules     DeliveryPricingRule[]
}

model DeliveryPricingRule {
  id              String        @id @default(cuid())
  zone            DeliveryZone  @relation(fields: [deliveryZoneId], references: [id], onDelete: Cascade)
  deliveryZoneId  String
  deliveryType    DeliveryType
  baseFeeKobo     Int           @default(0)
  perMeterKobo    Int           @default(0)
  minOrderKobo    Int           @default(0)
  estimatedMinutes Int?
  enabled         Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([deliveryZoneId, deliveryType])
}

model Rider {
  id                         String            @id @default(cuid())
  user                       User              @relation(fields: [userId], references: [id])
  userId                     String            @unique
  vehicle                    String?
  bankName                   String?
  bankAccountName            String?
  bankAccountNumber          String?
  isActive                   Boolean           @default(true)
  available                  Boolean           @default(true)
  isApproved                 Boolean           @default(false)
  neighborhoodApproval       PartnerApproval   @default(PENDING)
  professionalApproval       PartnerApproval   @default(NOT_APPLIED)
  professionalUpgradeStatus  String            @default("")
  canAcceptNeighborhood      Boolean           @default(false)
  deliveryMode               DeliveryMode      @default(MOTORCYCLE)
  serviceRadiusMeters        Int               @default(5000)
  operatingArea              String?
  kycStatus                  KycStatus         @default(NOT_STARTED)
  operationalStatus          OperationalStatus @default(OFFLINE)
  onboardingData             Json              @default("{}")
  neighborhood               String?
  regionId                   String?
  region                     Region?   @relation(fields: [regionId], references: [id], onDelete: SetNull)
  location                   RiderLocation?
  inspections                RiderInspection[]
  payoutRequests             RiderPayoutRequest[]
  createdAt                  DateTime          @default(now())
  updatedAt                  DateTime          @updatedAt
  orders                     Order[]

  @@index([isApproved, isActive, available])
  @@index([neighborhoodApproval, isActive, available])
  @@index([professionalApproval, isActive, available])
  @@index([operationalStatus])
  @@index([neighborhood])
}

model RiderOnboardingField {
  id         String   @id @default(cuid())
  key        String   @unique
  label      String
  type       String
  required   Boolean  @default(false)
  active     Boolean  @default(true)
  order      Int      @default(0)
  gatingRule String?
  options    String[] @default([])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

enum OrderSource {
  RESTAURANT
  COOK
  OTHER_FUTURE
}

enum DeliveryType {
  NEIGHBORHOOD
  PROFESSIONAL
}

enum DeliveryMode {
  WALK
  BICYCLE
  MOTORCYCLE
  CAR
}

enum PartnerApproval {
  NOT_APPLIED
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum OperationalStatus {
  OFFLINE
  ONLINE
  BUSY
}

enum RegionType {
  CONTINENT
  COUNTRY
  STATE
  CITY
  LGA
  POPULAR_STREET
  MARKET
  BUS_STOP
}

model Region {
  id        String     @id @default(cuid())
  type      RegionType
  name      String
  code      String?    @unique
  parentId  String?
  parent    Region?    @relation("RegionChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children  Region[]   @relation("RegionChildren")
  path      String     @default("/")
  isCovered Boolean    @default(false)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  cookProfiles CookProfile[]
  riders       Rider[]
  managementEmployees ManagementEmployee[]
  orders       Order[]

  @@index([parentId])
  @@index([path])
}

enum KycStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  NEEDS_INFORMATION
}

model Order {
  id                       String               @id @default(cuid())
  orderNumber              String               @unique
  customer                 User?                @relation(fields: [customerId], references: [id])
  customerId               String?
  source                   OrderSource          @default(RESTAURANT)
  cook                     CookProfile?         @relation(fields: [cookId], references: [id])
  cookId                   String?
  cookListing              CookListing?         @relation(fields: [cookListingId], references: [id])
  cookListingId            String?
  status                   String               @default("PENDING_PAYMENT")
  paymentStatus            String               @default("PENDING")
  items                    OrderItem[]
  sides                    OrderSide[]
  address                  String
  phone                    String
  region                   Region?              @relation(fields: [regionId], references: [id], onDelete: SetNull)
  regionId                 String?
  deliveryZone             DeliveryZone?        @relation(fields: [deliveryZoneId], references: [id])
  deliveryZoneId           String?
  deliveryType             DeliveryType         @default(NEIGHBORHOOD)
  deliveryFeeKobo          Int
  subtotalKobo             Int
  totalKobo                Int
  currency                 String               @default("NGN")
  payment                  Payment?
  refunds                  Refund[]
  statusHistory            OrderStatusHistory[]
  messages                 Message[]
  review                   Review?
  earning                  CookEarning?
  deliveryCode             String?              @unique
  idempotencyKey           String?              @unique
  rider                    Rider?               @relation(fields: [riderId], references: [id])
  riderId                  String?
  riderStatus              String               @default("UNASSIGNED")
  riderFeeKobo             Int                  @default(0)
  riderFeeBasis            DeliveryType?        @default(NEIGHBORHOOD)
  riderPaid                Boolean              @default(false)
  pickupCode               String?              @unique
  pickupCodeVerifiedAt     DateTime?
  tripStartedAt            DateTime?
  cookAcceptedAt           DateTime?
  cookReadyAt              DateTime?
  deliveredAt              DateTime?
  deliveredCodeVerifiedAt  DateTime?
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt

  @@index([cookId, status])
  @@index([customerId, createdAt])
  @@index([deliveryType, status, riderId])
  @@index([deliveryZoneId, status])
  @@index([riderId, status])
}

model OrderItem {
  id            String        @id @default(cuid())
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId       String
  cookListing   CookListing?  @relation(fields: [cookListingId], references: [id])
  cookListingId String?
  foodName      String
  optionLabel   String
  optionValue   String?
  unitPriceKobo Int
  quantity      Int
  totalKobo     Int
  orderingMode  String

  @@index([cookListingId])
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  CANCELLED
  EXPIRED
  REFUNDED
}

enum PaymentProvider {
  MOCK
  PAYSTACK
  FLUTTERWAVE
  STRIPE
  CRYPTO
  BANK_TRANSFER
}

model Payment {
  id            String          @id @default(cuid())
  order         Order           @relation(fields: [orderId], references: [id])
  orderId       String          @unique
  status        PaymentStatus   @default(PENDING)
  provider      PaymentProvider @default(MOCK)
  providerRef   String?
  amountKobo    Int
  currency      String          @default("NGN")
  feeKobo       Int             @default(0)
  metadata      Json?           @default("{}")
  refundKobo    Int             @default(0)
  refunds       Refund[]
  attempts      PaymentAttempt[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([providerRef])
}

model Refund {
  id            String   @id @default(cuid())
  payment       Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  paymentId     String
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId       String
  amountKobo    Int
  reason        String?
  disputeId     String?
  ticketId      String?
  approvedBy    String?
  status        String   @default("PENDING") // PENDING, ISSUED, FAILED
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([paymentId])
  @@index([orderId])
  @@index([disputeId])
}

model PaymentAttempt {
  id          String        @id @default(cuid())
  payment     Payment       @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  paymentId   String
  providerRef String?
  status      PaymentStatus
  payload     Json?
  createdAt   DateTime      @default(now())
}

model OrderStatusHistory {
  id        String   @id @default(cuid())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  status    String
  actor     String?
  note      String?
  createdAt DateTime @default(now())
}

model RestaurantSetting {
  id           String   @id @default(cuid())
  name         String   @default("OYE Well")
  currency     String   @default("NGN")
  logoUrl      String?
  contactPhone String?
  contactEmail String?
  latitude     Float?
  longitude    Float?
  mapSettings  Json?    @default("{}")
  googleAds    Json?    @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model PaymentMethodConfig {
  id        String   @id @default(cuid())
  name      String   @unique
  enabled   Boolean  @default(false)
  provider  String
  publicKey String?
  config    Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EmailConfig {
  id       String  @id @default(cuid())
  host     String
  port     Int
  secure   Boolean @default(true)
  user     String
  pass     String
  from     String
  enabled  Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Side {
  id          String    @id @default(cuid())
  name        String
  description String?
  priceKobo   Int
  isAvailable Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  orders      OrderSide[]
}

model OrderSide {
  id          String @id @default(cuid())
  order       Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId     String
  side        Side   @relation(fields: [sideId], references: [id])
  sideId      String
  name        String
  priceKobo   Int
  quantity    Int    @default(1)
  totalKobo   Int
}

enum CookProfileStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SUSPENDED
  BANNED
}

enum CookKitchenStatus {
  OPEN
  CLOSED
  PAUSED
  SUSPENDED
  PENDING_APPROVAL
  ADMIN_DISABLED
}

enum CookListingStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  PAUSED
  SOLD_OUT
  ARCHIVED
}

enum MediaType {
  IMAGE
  VIDEO
}

enum CookEarningStatus {
  PENDING
  SETTLED
  CANCELLED
}

model CookProfile {
  id                   String            @id @default(cuid())
  user                 User              @relation(fields: [userId], references: [id])
  userId               String            @unique
  displayName          String
  profilePhoto         String?
  bio                  String?
  latitude             Float?
  longitude            Float?
  serviceRadiusKm      Float             @default(5)
  cuisineSpecialty     String?
  categories           String[]          @default([])
  signatureDishes      String[]          @default([])
  capacity             String?
  prepTime             String?
  availability         Json?             @default("{}")
  packagingPhotos      String[]
  packagingApproved    Boolean           @default(false)
  safetyAcknowledgements Json?           @default("[]")
  termsAcceptedAt      DateTime?
  onboardingStep       Int               @default(1)
  profileStatus        CookProfileStatus @default(PENDING_APPROVAL)
  kitchenStatus        CookKitchenStatus @default(PENDING_APPROVAL)
  rating               Float             @default(0)
  totalOrders          Int               @default(0)
  isActive             Boolean           @default(true)
  banned               Boolean           @default(false)
  banReason            String?
  neighborhood         String?
  neighborhoods        String[]          @default([])
  regionId             String?
  region               Region?   @relation(fields: [regionId], references: [id], onDelete: SetNull)
  approvedById         String?
  approvedAt           DateTime?
  approvedBy           User?             @relation("CookApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  listings             CookListing[]
  foods                Food[]
  orders               Order[]
  earnings             CookEarning[]
  reviews              Review[]

  @@index([neighborhood])
}

model CookListing {
  id                   String            @id @default(cuid())
  cook                 CookProfile       @relation(fields: [cookId], references: [id], onDelete: Cascade)
  cookId               String
  title                String
  description          String?
  priceKobo            Int
  packagingCostKobo    Int               @default(0)
  currency             String            @default("NGN")
  portionDescription   String?
  prepTimeMinutesMin   Int?
  prepTimeMinutesMax   Int?
  availability         String?
  quantity             Int               @default(0)
  stock                Int               @default(0)
  ingredients          String?
  allergens            String?
  cuisine              String?
  status               CookListingStatus @default(DRAFT)
  isActive             Boolean           @default(false)
  featured             Boolean           @default(false)
  approvedById         String?
  approvedAt           DateTime?
  approvedBy           User?             @relation("ListingApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  media                CookListingMedia[]
  orderItems           OrderItem[]
  orders               Order[]
  reviews              Review[]
  likes                CookListingLike[]
  views                CookListingView[]

  @@index([status, isActive, createdAt])
  @@index([cookId, status])
  @@index([featured, status, isActive])
}

model CookListingMedia {
  id          String   @id @default(cuid())
  listing     CookListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId   String
  type        MediaType
  url         String
  thumbnailUrl String?
  ordering    Int      @default(0)
  width       Int?
  height      Int?
  duration    Int?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([listingId, ordering])
}

model CookListingLike {
  id          String   @id @default(cuid())
  listing     CookListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId   String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  createdAt   DateTime @default(now())

  @@unique([listingId, userId])
  @@index([listingId])
  @@index([userId])
}

model CookListingView {
  id          String   @id @default(cuid())
  listing     CookListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId   String
  viewerId    String
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String?
  createdAt   DateTime @default(now())

  @@unique([listingId, viewerId])
  @@index([listingId])
  @@index([viewerId])
}

model UserAddress {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  label       String?
  address     String
  latitude    Float?
  longitude   Float?
  neighborhood String?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([neighborhood])
}

model Conversation {
  id          String    @id @default(cuid())
  context     String?   // ORDER, DELIVERY, SUPPORT, DISPUTE
  contextId   String?
  contextType String?
  title       String?
  isOpen      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  messages    Message[]

  @@index([context, contextId])
}

model Message {
  id             String         @id @default(cuid())
  order          Order?         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId        String?
  conversation   Conversation?  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String?
  senderId       String
  recipientId    String
  content        String
  readAt         DateTime?
  createdAt      DateTime       @default(now())

  @@index([orderId, createdAt])
  @@index([conversationId, createdAt])
  @@index([recipientId, readAt])
}

model Review {
  id          String      @id @default(cuid())
  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId     String      @unique
  customerId  String
  cookId      String?
  listingId   String?
  riderId     String?
  rating      Int
  comment     String?
  createdAt   DateTime    @default(now())
  cook        CookProfile? @relation(fields: [cookId], references: [id], onDelete: SetNull)
  listing     CookListing? @relation(fields: [listingId], references: [id], onDelete: SetNull)

  @@index([cookId])
  @@index([listingId])
}

model CookEarning {
  id          String            @id @default(cuid())
  cook        CookProfile       @relation(fields: [cookId], references: [id], onDelete: Cascade)
  cookId      String
  order       Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId     String            @unique
  amountKobo  Int
  status      CookEarningStatus @default(PENDING)
  settledAt   DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model RiderInspection {
  id            String   @id @default(cuid())
  rider         Rider    @relation(fields: [riderId], references: [id], onDelete: Cascade)
  riderId       String
  scheduledAt   DateTime?
  inspectedAt   DateTime?
  inspector     String?
  result        String   @default("PENDING")
  notes         String?
  photos        String[]
  nextInspectionAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([riderId])
}

model RiderLocation {
  id        String   @id @default(cuid())
  rider     Rider    @relation(fields: [riderId], references: [id], onDelete: Cascade)
  riderId   String   @unique
  latitude  Float
  longitude Float
  accuracy  Float?
  updatedAt DateTime @updatedAt

  @@index([latitude, longitude])
}

model RiderPayoutRequest {
  id            String            @id @default(cuid())
  rider         Rider             @relation(fields: [riderId], references: [id], onDelete: Cascade)
  riderId       String
  amountKobo    Int
  status        PayoutStatus      @default(PENDING)
  requestedAt   DateTime          @default(now())
  settledAt     DateTime?
  idempotencyKey String?          @unique
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([riderId, status])
}

enum PayoutStatus {
  PENDING
  SETTLED
  REJECTED
}

model FeatureFlag {
  id        String   @id @default(cuid())
  key       String   @unique
  enabled   Boolean  @default(false)
  rollout   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum TaskType {
  FOOD
  PACKAGE
  ERRAND
  SHOPPING
}

enum TaskStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model GenericTask {
  id          String     @id @default(cuid())
  customerId  String?
  riderId     String?
  type        TaskType
  status      TaskStatus @default(PENDING)
  pickup      Json?
  dropoff     Json?
  notes       String?
  feeKobo     Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

enum ManagementEmployeeStatus {
  ACTIVE
  SUSPENDED
  INVITED
  INACTIVE
}

model ManagementEmployee {
  id           String                 @id @default(cuid())
  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String                 @unique
  employeeId   String                 @unique
  tier         AdminTier              @relation(fields: [adminTierId], references: [id])
  adminTierId  String
  department       String?
  status           ManagementEmployeeStatus @default(INVITED)
  limits           Json?                  @default("{}")
  regionId         String?
  region           Region?                @relation(fields: [regionId], references: [id], onDelete: SetNull)
  areas            ModeratorArea[]
  balanceKobo      Int                    @default(0)
  bankName         String?
  bankAccountNumber String?
  bankAccountName  String?
  lastLoginAt      DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
}

model AdminTier {
  id          String               @id @default(cuid())
  key         String               @unique
  name        String
  description String?
  isActive    Boolean              @default(true)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  employees   ManagementEmployee[]
  permissions AdminTierPermission[]
}

model Permission {
  id          String                @id @default(cuid())
  key         String                @unique
  scope       String
  description String?
  tierPermissions AdminTierPermission[]
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
}

model AdminTierPermission {
  id          String    @id @default(cuid())
  tier        AdminTier @relation(fields: [adminTierId], references: [id], onDelete: Cascade)
  adminTierId String
  permission  Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  permissionId String

  @@unique([adminTierId, permissionId])
}

enum ModeratorAreaScope {
  GLOBAL
  COUNTRY
  STATE
  CITY
  DISTRICT
  SERVICE_AREA
  COMMUNITY
}

model ModeratorArea {
  id          String              @id @default(cuid())
  employee    ManagementEmployee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId  String
  scope       ModeratorAreaScope
  country     String?
  region      String?
  city        String?
  district    String?
  area        String?
  latitude    Float?
  longitude   Float?
  radiusMeters Int?
  createdAt   DateTime            @default(now())

  @@index([employeeId])
  @@index([scope, country, region, city])
}

enum ApprovalStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  MORE_INFORMATION_REQUIRED
  APPROVED
  REJECTED
  SUSPENDED
}

enum ApprovalType {
  COOK
  RIDER
  RIDER_PROFESSIONAL
  PACKAGING
  MENU
  SPECIAL
  REFUND
}

model Approval {
  id            String         @id @default(cuid())
  type          ApprovalType
  targetId      String
  targetType    String
  status        ApprovalStatus @default(DRAFT)
  submittedBy   String?
  submittedAt   DateTime?
  reviewedBy    String?
  reviewedAt    DateTime?
  note          String?
  moreInfo      String?
  data          Json?          @default("{}")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([type, status])
  @@index([targetId, targetType])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorId     String?
  actorType   String?
  action      String
  targetId    String?
  targetType  String?
  reason      String?
  oldState    Json?    @default("{}")
  newState    Json?    @default("{}")
  reference   String?
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([action, createdAt])
  @@index([actorId, createdAt])
  @@index([targetId, targetType])
}

enum ReportStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  DISMISSED
  ESCALATED
}

model Report {
  id          String       @id @default(cuid())
  reporterId  String
  targetId    String
  targetType  String       // USER, COOK, LISTING, MESSAGE, ORDER, RIDER
  reason      String
  details     String?
  evidence    String[]
  status      ReportStatus @default(OPEN)
  assignedTo  String?
  resolution  String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([status, createdAt])
  @@index([reporterId])
  @@index([targetId, targetType])
}

model UserBlock {
  id          String   @id @default(cuid())
  blockerId   String
  blockedId   String
  reason      String?
  createdAt   DateTime @default(now())

  @@unique([blockerId, blockedId])
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_CUSTOMER
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model Ticket {
  id              String         @id @default(cuid())
  ticketNumber    String         @unique
  customerId      String
  category        String
  internalCategory String?
  orderId         String?
  deliveryId      String?
  priority        TicketPriority @default(NORMAL)
  status          TicketStatus   @default(OPEN)
  assignedTo      String?
  subject         String
  messages        Json?          @default("[]")
  attachments     String[]
  internalNotes   Json?          @default("[]")
  resolution      String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([customerId, createdAt])
  @@index([status, createdAt])
  @@index([assignedTo, status])
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  WAITING_FOR_CUSTOMER
  WAITING_FOR_PROVIDER
  ESCALATED
  RESOLVED
  CLOSED
  APPEALED
}

enum DisputeType {
  FOOD_NOT_RECEIVED
  WRONG_FOOD
  MISSING_ITEM
  FOOD_QUALITY
  DELIVERY_ISSUE
  PAYMENT_PROBLEM
  UNAUTHORIZED_ACTION
  RIDER_COMPLAINT
  COOK_COMPLAINT
  OTHER
}

model Dispute {
  id            String        @id @default(cuid())
  disputeNumber String        @unique
  customerId    String
  type          DisputeType
  orderId       String?
  cookId        String?
  riderId       String?
  status        DisputeStatus @default(OPEN)
  assignedTo    String?
  description   String?
  timeline      Json?         @default("[]")
  resolution    String?
  refundKobo    Int?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([customerId, createdAt])
  @@index([status, createdAt])
  @@index([assignedTo, status])
}

enum CaseEvidenceType {
  ORDER_SNAPSHOT
  PAYMENT_RECORD
  CHAT_MESSAGE
  LOCATION_RECORD
  UPLOADED_PHOTO
  UPLOADED_VIDEO
  SYSTEM_LOG
  REFUND_RECORD
  TIMELINE_EVENT
}

model CaseEvidence {
  id          String          @id @default(cuid())
  caseType    String          // DISPUTE, TICKET, REPORT, APPROVAL
  caseId      String
  evidenceType CaseEvidenceType
  title       String?
  description String?
  data        Json?           @default("{}")
  sourceUrl   String?
  createdBy   String?
  createdAt   DateTime        @default(now())

  @@index([caseType, caseId])
  @@index([evidenceType, createdAt])
}

enum LegalDocumentType {
  TERMS_OF_SERVICE
  COMMUNITY_FOOD_PROVIDER_AGREEMENT
  PRIVACY_POLICY
  FOOD_SAFETY_RULES
  DELIVERY_RULES
  REFUND_DISPUTE_POLICY
  COMMUNITY_GUIDELINES
}

model LegalDocument {
  id          String            @id @default(cuid())
  type        LegalDocumentType @unique
  version     String
  title       String
  content     String
  activeFrom  DateTime          @default(now())
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([type, activeFrom])
}

model TermsAcceptance {
  id           String   @id @default(cuid())
  userId       String
  documentType String
  version      String
  acceptedAt   DateTime @default(now())
  ip           String?

  @@unique([userId, documentType, version])
  @@index([userId])
}

model PasswordReset {
  id        String    @id @default(cuid())
  email     String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
}
